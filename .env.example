# ExpressBites no usa variables de entorno.
# - La API de clima (Open-Meteo) no necesita clave.
# - La configuración de Firebase NO va aquí: se genera con
#   `flutterfire configure --project=<ID_DEL_PROYECTO> --platforms=android`
#   y crea lib/firebase_options.dart y android/app/google-services.json (ignorados por Git).
FIREBASE_PROJECT_ID=
